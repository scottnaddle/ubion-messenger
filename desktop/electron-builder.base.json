{
  "appId": "global.ubion.messenger",
  "productName": "UBION Messenger",
  "directories": {
    "output": "release"
  },
  "files": [
    "out/main/**",
    "out/preload/**",
    "out/renderer/**",
    "package.json"
  ],
  "asar": true,
  "mac": {
    "category": "public.app-category.social-networking",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "identity": null,
    "hardenedRuntime": false,
    "icon": "resources/icon.icns",
    "artifactName": "UBION-Messenger-${version}-${arch}-mac.${ext}",
    "extendInfo": {
      "NSUserNotificationAlertStyle": "alert"
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "resources/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "UBION-Messenger-${version}-Setup.${ext}",
    "perMachine": false,
    "createDesktopShortcut": true,
    "shortcutName": "UBION Messenger"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "scottnaddle",
      "repo": "ubion-messenger-releases",
      "releaseType": "release"
    }
  ],
  "artifactName": "UBION-Messenger-${version}-${os}-${arch}.${ext}",
  "extraResources": [
    {
      "from": "resources",
      "to": "resources",
      "filter": [
        "*.png",
        "*.ico",
        "*.icns"
      ]
    }
  ],
  "dmg": {
    "artifactName": "UBION-Messenger-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "resources/icon-1024.png",
    "category": "Network"
  },
  "compression": "normal"
}
