{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "electron/core/types.ts", "electron/core/messages.ts", "electron/core/chat-delete.ts", "electron/core/forward.ts", "electron/core/room-notice.ts", "electron/core/flex.ts", "electron/core/portal.ts", "electron/core/attach.ts", "electron/core/mail.ts", "electron/core/mail-compose.ts", "electron/core/mail-text.ts", "electron/core/mail-attach.ts", "electron/core/bot-settings.ts", "electron/core/backup.ts", "electron/core/capture.ts", "electron/core/doc-preview.ts"]
}
