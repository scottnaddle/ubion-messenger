{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "out",
    "declaration": true,
    "esModuleInterop": true
  },
  "include": ["electron/**/*", "scripts/**/*", "electron.vite.config.ts"]
}
